<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0F12">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="单机跑刀机器人 Demo" android:textColor="#FFFFFF"
            android:textSize="27sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="图像状态识别 + Accessibility 触摸手势"
            android:textColor="#9AA0AA" android:textSize="14sp"/>
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="#191C21" android:padding="15dp"
            android:text="状态：待机" android:textColor="#FFFFFF" android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/accessibilityButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="打开无障碍设置"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="开始 Demo"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="停止"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="路线点"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/route" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:background="#191C21" android:padding="15dp"
            android:textColor="#DDE1E8" android:textSize="15sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="识别说明"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/info" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="本 Demo 将“识别状态”和“触摸动作”拆成独立模块。你可以把自己的单机游戏截图识别器接入 ImageStateDetector，再把动作接入 BotAccessibilityService。"
            android:textColor="#AEB5C0" android:textSize="14sp"/>
        <TextView android:id="@+id/log" android:layout_width="match_parent"
            android:layout_height="260dp" android:layout_marginTop="18dp"
            android:background="#090A0C" android:padding="14dp"
            android:text="日志已就绪" android:textColor="#AEB5C0" android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
